{
  "name": "in-seconds.client-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:arch": "sheriff verify src/main.ts && node scripts/check-pure-domain.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
