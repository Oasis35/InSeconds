        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/service-worker": "22.2.0",
    "@ngrx/signals": "22.0.1",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@softarc/sheriff-core": "0.20.0",
    "@tailwindcss/postcss": "4.3.3",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
