{
  "name": "in-seconds.client-v2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-api": "nswag run nswag/players.nswag.json /runtime:Net100 && nswag run nswag/catalogue.nswag.json /runtime:Net100",
    "lint:arch": "sheriff verify src/main.ts src/app/gameplay/feature/track-round.component.ts src/app/gameplay/feature/provide-gameplay.ts && node scripts/check-pure-domain.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:list": "playwright test --list"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@angular/service-worker": "22.2.0",
    "@ngrx/signals": "22.0.1",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "howler": "2.2.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@playwright/test": "1.63.0",
    "@softarc/sheriff-core": "0.20.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/howler": "2.2.13",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.2",
    "nswag": "14.7.1",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "5.0.2"
  }
}
