FROM node:24-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .

# production (défaut) ou staging : choisit le fichier environment*.ts via angular.json.
ARG BUILD_CONFIGURATION=production
# Heure du déploiement affichée en admin (piège 25) : posée par le déploiement (deploy.sh exporte BUILD_TIME à chaque
# déploiement). Un argument de build qui change invalide le cache de cette étape : sans lui, un déploiement qui ne touche pas au
# front réutiliserait le build en cache et l'heure resterait figée sur le dernier déploiement qui a modifié le front.
ARG BUILD_TIME=
RUN if [ -n "$BUILD_TIME" ]; then \
      npm run build -- --configuration "$BUILD_CONFIGURATION" --define "BUILD_TIME='$BUILD_TIME'"; \
    else \
      npm run build -- --configuration "$BUILD_CONFIGURATION"; \
    fi

# Content-Security-Policy (G3) : en observation (Report-Only) par défaut ; CSP_MODE=enforce la rend bloquante.
# CSP_API_ORIGIN : origine de l'API de l'environnement (le staging passe https://api-dev.inseconds.cc).
ARG CSP_MODE=report-only
ARG CSP_API_ORIGIN=https://api.inseconds.cc
RUN case "$CSP_MODE" in \
      report-only) header=Content-Security-Policy-Report-Only ;; \
      enforce) header=Content-Security-Policy ;; \
      *) echo "CSP_MODE doit valoir report-only ou enforce (reçu : $CSP_MODE)" >&2; exit 1 ;; \
    esac \
 && sed -e "s|__CSP_HEADER_NAME__|$header|g" \
        -e "s|__CSP_API_ORIGIN__|$CSP_API_ORIGIN|g" \
        nginx/csp.conf.template > /tmp/csp.conf \
 && printf '\n// CSP %s\n' "$(sha256sum /tmp/csp.conf | cut -c1-16)" >> dist/InSeconds.Client/browser/ngsw-worker.js
# Un service worker garde la CSP reçue à son installation, et le navigateur ne le réinstalle que si
# son script change : la ligne ajoutée ci-dessus change le script avec la CSP, sinon un worker installé
# sous une ancienne CSP continuerait de l'appliquer à ses requêtes (504 sur les extraits Deezer, 19/10/2026).

FROM nginxinc/nginx-unprivileged:alpine AS runtime
COPY --from=build /app/dist/InSeconds.Client/browser /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /tmp/csp.conf /etc/nginx/snippets/csp.conf

EXPOSE 8080
