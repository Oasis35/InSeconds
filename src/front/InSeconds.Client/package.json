{
  "name": "in-seconds.client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate-api": "nswag run nswag/players.nswag.json /runtime:Net100 && nswag run nswag/catalogue.nswag.json /runtime:Net100 && nswag run nswag/daily.nswag.json /runtime:Net100 && nswag run nswag/runs.nswag.json /runtime:Net100 && nswag run nswag/social.nswag.json /runtime:Net100 && nswag run nswag/admin.nswag.json /runtime:Net100",
    "lint:arch": "sheriff verify src/main.ts && node scripts/check-pure-domain.mjs && node scripts/check-home-split.mjs && node --test scripts/check-home-split.test.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:list": "playwright test --list"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.7",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/service-worker": "22.2.6",
    "@ngrx/signals": "22.0.1",
    "@ngx-translate/core": "18.1.0",
    "@ngx-translate/http-loader": "18.1.0",
    "@zootools/email-spell-checker": "1.13.0",
    "gsap": "3.15.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@playwright/test": "1.65.1",
    "@softarc/sheriff-core": "0.20.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "nswag": "14.8.0",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
