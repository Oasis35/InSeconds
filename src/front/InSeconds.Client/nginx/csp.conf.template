# Content-Security-Policy du front (G3, S14). Modèle : Dockerfile.prod remplace les trois jetons
# (nom de l'en-tête, origine de l'API, politique) et installe le résultat à côté de security-headers.conf.
#   CSP_HEADER_NAME : Content-Security-Policy-Report-Only (observation) ou Content-Security-Policy (bloquant)
#   CSP_API_ORIGIN  : origine de l'API de l'environnement (https://api.inseconds.cc, https://api-dev.inseconds.cc)
# Origines autorisées, et pourquoi :
#   - API : fetch/XHR (connect-src) ;
#   - *.dzcdn.net : extraits audio, lus par un élément audio (media-src), pochettes (img-src), et un octet
#     d'un extrait illisible demandé par fetch pour connaître la réponse du CDN (connect-src, diagnostic AudioError) ;
#   - Google Fonts : feuille de style (style-src) et polices (font-src) ;
#   - Cloudflare Web Analytics : script injecté par Cloudflare dans index.html (script-src static.cloudflareinsights.com),
#     qui envoie ses mesures au même domaine (/cdn-cgi/rum, couvert par 'self') ;
#   - connect-src reprend les origines tierces lues à travers le service worker (extraits, pochettes, Google Fonts,
#     script de Cloudflare) :
#     le worker les redemande par fetch, sous sa propre CSP (piège 49) ;
#   - blob: pour le silence du déverrouillage audio (iPhone) et data: pour les images en ligne (stories de l'admin) ;
#   - style-src 'unsafe-inline' : Angular écrit les styles de ses composants en ligne. Aucun script en ligne.
# Rapports de violation : envoyés par le navigateur lui-même à l'API (POST /api/csp-reports), dès le chargement de la page,
# avant le démarrage d'Angular. report-to (Reporting API, groupe « csp » déclaré par Reporting-Endpoints) pour Chrome et
# Edge, report-uri pour Firefox et Safari ; un navigateur qui connaît report-to ignore report-uri.
add_header Reporting-Endpoints 'csp="__CSP_API_ORIGIN__/api/csp-reports"' always;
add_header __CSP_HEADER_NAME__ "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.dzcdn.net; media-src 'self' blob: https://*.dzcdn.net; connect-src 'self' __CSP_API_ORIGIN__ https://*.dzcdn.net https://fonts.googleapis.com https://fonts.gstatic.com https://static.cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri __CSP_API_ORIGIN__/api/csp-reports; report-to csp" always;
