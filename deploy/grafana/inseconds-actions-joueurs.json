{
  "__inputs": [
    {
      "name": "DS_LOGS",
      "label": "Logs (Loki)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "InSeconds — Actions joueurs en direct",
  "uid": "inseconds-actions",
  "tags": [
    "inseconds"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "player",
        "label": "PlayerId (vide = tous)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Actions par minute",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "range",
          "legendFormat": "actions",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |~ \"démarrée par|reprise par|Réponse de|terminée par|Indice niveau|abandonnée par|Connexion par magic link|Email « |envoi de l'email\" |= \"$player\" [1m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Fil des actions joueurs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "range",
          "expr": "{service_name=\"inseconds-api\"} |~ \"démarrée par|reprise par|Réponse de|terminée par|Indice niveau|abandonnée par|Connexion par magic link|Email « |envoi de l'email\" |= \"$player\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}