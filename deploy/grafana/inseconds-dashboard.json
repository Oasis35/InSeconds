{
  "__inputs": [
    {
      "name": "DS_LOGS",
      "label": "Logs (Loki)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "InSeconds",
  "uid": "inseconds-overview",
  "tags": [
    "inseconds"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erreurs (période affichée)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"error\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Parties terminées (période affichée)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"terminée par\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Parties démarrées (période affichée)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"démarrée par\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Connexions (période affichée)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"Connexion par magic link\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Erreurs dans le temps",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"error\" [$__interval]))",
          "legendFormat": "erreurs",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"warn\" [$__interval]))",
          "legendFormat": "warnings",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Parties : démarrées / terminées / abandonnées",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"démarrée par\" [$__interval]))",
          "legendFormat": "démarrées",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"terminée par\" [$__interval]))",
          "legendFormat": "terminées",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"abandonnée par\" [$__interval]))",
          "legendFormat": "abandonnées",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Dernières erreurs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "{service_name=\"inseconds-api\"} | detected_level=\"error\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}