{
  "__inputs": [
    {
      "name": "DS_LOGS",
      "label": "Logs (Loki)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "InSeconds — Erreurs et warnings",
  "uid": "inseconds-erreurs",
  "tags": [
    "inseconds"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "filtre",
        "label": "Filtre texte (code d'erreur, PlayerId…)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Erreurs (période)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"error\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (période, hors Wolverine)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"warn\" != \"Utilizing service location\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs remontées par le front",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"Erreur front\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Réponses 500 de l'API",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} |= \"An unhandled exception has occurred\" [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Erreurs et warnings dans le temps",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"error\" [$__interval]))",
          "legendFormat": "Erreurs"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "range",
          "expr": "sum(count_over_time({service_name=\"inseconds-api\"} | detected_level=\"warn\" != \"Utilizing service location\" [$__interval]))",
          "legendFormat": "Warnings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Erreurs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Warnings"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs d'erreur",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "range",
          "expr": "{service_name=\"inseconds-api\"} | detected_level=\"error\" |= \"$filtre\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Logs de warning (hors Wolverine)",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOGS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "queryType": "range",
          "expr": "{service_name=\"inseconds-api\"} | detected_level=\"warn\" != \"Utilizing service location\" |= \"$filtre\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}