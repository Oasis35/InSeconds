# Copier ce fichier en .env sur le VPS (dans deploy/infra/), renseigner les valeurs réelles.
# .env n'est pas commité (voir .gitignore racine).

# Mot de passe du superuser Postgres (compte "postgres") — sert uniquement à
# l'administration de l'instance (création de nouvelles bases/users par projet).
POSTGRES_SUPERUSER_PASSWORD=changeme

# Mot de passe de l'utilisateur "inseconds" créé au premier démarrage par
# init/01-inseconds.sh. Doit être IDENTIQUE à INSECONDS_DB_PASSWORD dans le
# .env.prod du projet InSeconds (docker-compose.prod.yml à la racine du repo).
INSECONDS_DB_PASSWORD=changeme
