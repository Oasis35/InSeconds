# Copier ce fichier en .env sur le VPS (dans deploy/infra/), renseigner les valeurs réelles.
# .env n'est pas commité (voir .gitignore racine).

# Mot de passe du superuser Postgres (compte "postgres") — sert uniquement à
# l'administration de l'instance (création de nouvelles bases/users par projet).
POSTGRES_SUPERUSER_PASSWORD=changeme

# Mot de passe de l'utilisateur "inseconds" créé au premier démarrage par
# init/01-inseconds.sh. Doit être IDENTIQUE à INSECONDS_DB_PASSWORD dans le
# .env.prod du projet InSeconds (docker-compose.prod.yml à la racine du repo).
INSECONDS_DB_PASSWORD=changeme

# --- Sauvegardes (backup.sh, cf. README § Sauvegardes) ---------------------------------------
# Tout est facultatif : sans les quatre variables R2, la sauvegarde reste sur le VPS.
# BACKUP_DIR=/home/debian/backups/postgres   # défaut : ~/backups/postgres
# Clé d'accès R2 (Account API token R2, Object Read & Write limité au bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Adresse « S3 API » du bucket, sans le nom du bucket à la fin
R2_ENDPOINT=
# R2_BUCKET=inseconds-backups
# Phrase de passe du chiffrement (openssl rand -base64 32), à garder AUSSI dans le gestionnaire
# de mots de passe : sans elle, les sauvegardes de R2 sont illisibles
BACKUP_ENCRYPTION_PASSWORD=
# URL de ping healthchecks.io (alerte si une nuit passe sans sauvegarde réussie)
HEALTHCHECK_URL=
# Durées de conservation (jours) : défauts 7 (VPS), 30 (R2 daily/), 365 (R2 monthly/)
# BACKUP_LOCAL_KEEP_DAYS=7
# BACKUP_REMOTE_DAILY_KEEP_DAYS=30
# BACKUP_REMOTE_MONTHLY_KEEP_DAYS=365
