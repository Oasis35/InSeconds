# Contrôle de restauration de la sauvegarde de la nuit (deploy/infra/backup-verify.sh), lancé par
# inseconds-backup-verify.timer. Installation et suivi : deploy/infra/README.md § Contrôle de restauration.
# Le script est lu dans le checkout de prod, remis à jour à chaque déploiement. Prod seulement : depuis le
# checkout du staging, le script refuse de tourner.
[Unit]
Description=Contrôle de restauration de la sauvegarde InSeconds (R2 + Postgres jetable)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=debian
Group=debian
ExecStart=/home/debian/apps/InSeconds/deploy/infra/backup-verify.sh
# Un contrôle coincé ne doit pas bloquer celui du lendemain.
TimeoutStartSec=1h
