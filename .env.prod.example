# Copier ce fichier en .env.prod sur le VPS (racine du repo), renseigner les valeurs réelles.
# .env.prod n'est pas commité (voir .gitignore).
# Usage : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build  (v1 ; la v2 : docker-compose.prod-v2.yml)

# Doit être IDENTIQUE au mot de passe de l'utilisateur "inseconds" créé dans
# le stack infra partagé (deploy/infra/.env, clé INSECONDS_DB_PASSWORD).
INSECONDS_DB_PASSWORD=changeme

# Clé API Brevo (envoi des emails magic link / changement d'email)
BREVO_API_KEY=changeme

# Observabilité OpenTelemetry (logs, traces, métriques) vers Grafana Cloud.
# Laisser vide pour ne rien exporter. Valeurs : Grafana Cloud → stack → "OpenTelemetry" →
# Configure (endpoint OTLP de la région, Instance ID et un jeton en écriture seule
# "metrics:write logs:write traces:write").
# HEADERS = "Authorization=Basic%20" + base64("<instance-id>:<jeton>") (le %20 est obligatoire).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Mot de passe du certificat Data Protection de la prod (PLAN S16), exigé par la v2 (docker-compose.prod-v2.yml) : à
# renseigner AVANT la bascule, le workflow « Bascule v2 » s'arrête sinon. Le certificat lui-même est hors du dépôt, dans
# secrets/dataprotection.pfx à la racine du checkout (~/apps/InSeconds/secrets/), lisible par l'utilisateur de l'image de
# l'API (uid/gid 1654), par exemple :
#   sudo chgrp 1654 secrets/dataprotection.pfx && sudo chmod 640 secrets/dataprotection.pfx
# Ignoré par la v1.
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# Mode de la Content-Security-Policy du front v2 (G3) : report-only (défaut) ou enforce. Reste en report-only à la
# bascule ; enforce une semaine sans violation en prod après la mise en prod (#300). Ignoré par la v1.
CSP_MODE=report-only
