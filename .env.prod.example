# Copier ce fichier en .env.prod sur le VPS (racine du repo), renseigner les valeurs réelles.
# .env.prod n'est pas commité (voir .gitignore).
# Usage : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Doit être IDENTIQUE au mot de passe de l'utilisateur "inseconds" créé dans
# le stack infra partagé (deploy/infra/.env, clé INSECONDS_DB_PASSWORD).
INSECONDS_DB_PASSWORD=changeme

# Clé API Brevo (envoi des emails magic link / changement d'email)
BREVO_API_KEY=changeme

# Observabilité OpenTelemetry (logs, traces, métriques) vers Grafana Cloud.
# Laisser vide pour ne rien exporter. Valeurs : Grafana Cloud → stack → "OpenTelemetry" →
# Configure (endpoint OTLP de la région, Instance ID et un jeton en écriture seule
# "metrics:write logs:write traces:write").
# HEADERS = "Authorization=Basic%20" + base64("<instance-id>:<jeton>") (le %20 est obligatoire).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Surveillance de la sauvegarde (et, après la bascule, des tâches planifiées v2) par healthchecks.io (#315) : clé de
# ping du projet (healthchecks.io → projet → Settings → Ping key), à garder aussi dans KeePass. Vide = aucun signal.
# Lue par deploy/infra/backup.sh et par l'API v2 (docker-compose.prod-v2.yml). Ignorée par l'API v1.
HEALTHCHECKS_PING_KEY=
