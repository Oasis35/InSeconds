# Copier ce fichier en .env.staging sur le VPS (racine du checkout ~/apps/InSeconds-staging),
# renseigner les valeurs réelles. .env.staging n'est pas commité (voir .gitignore).
# Usage : ./deploy/vps/deploy.sh staging

# Mot de passe de l'utilisateur "inseconds_staging" (base "inseconds_staging"), créé à la main
# dans le Postgres partagé, cf. deploy/infra/README.md.
INSECONDS_STAGING_DB_PASSWORD=changeme

# Clé API Brevo (peut être la même que la prod).
BREVO_API_KEY=changeme

# Adresse qui reçoit TOUS les emails envoyés par le staging (bandeau DEV en tête du mail
# rappelant le destinataire d'origine). Obligatoire : l'API staging refuse de démarrer sans.
STAGING_EMAIL_REDIRECT_TO=

# Seule adresse email gardée telle quelle par la copie anonymisée de la base de prod
# (deploy/vps/copy-prod-db-to-staging.sh) : permet de se connecter en staging avec son
# propre compte (et son rôle admin). Toutes les autres adresses sont remplacées.
STAGING_KEEP_EMAIL=

# Mot de passe du certificat Data Protection du staging (PLAN S16), obligatoire : le déploiement
# échoue sans. Le certificat lui-même est hors du dépôt, dans secrets/dataprotection.pfx à la racine
# du checkout, monté en lecture seule dans l'API (docker-compose.staging.yml), qui le charge au démarrage.
# Il doit être lisible par l'utilisateur de l'image de l'API (uid/gid 1654), par exemple :
#   sudo chgrp 1654 secrets/dataprotection.pfx && sudo chmod 640 secrets/dataprotection.pfx
DATA_PROTECTION_CERTIFICATE_PASSWORD=

# Pas de variables OTEL_* : le staging n'envoie rien à Grafana (prod seulement), docker-compose.staging.yml
# ne les transmet pas à l'API.

# Surveillance des tâches planifiées par healthchecks.io (#315), facultatif : clé de ping du projet « [Dev]InSeconds »,
# JAMAIS celle du projet de prod (les contrôles portent les mêmes noms, la clé décide du projet). Sert à vérifier les
# signaux avant la mise en prod ; pas d'alerte Signal sur ce projet. Vide = aucun signal.
HEALTHCHECKS_PING_KEY=
